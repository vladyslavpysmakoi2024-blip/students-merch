├── .env                   # Локальні змінні середовища (доступи до БД, секретні ключі)
├── .gitignore             # Файли та папки, які ігноруються Git (напр., __pycache__, .env)
├── main.py                # Головна точка входу FastAPI (ініціалізація app, підключення всіх роутерів)
└── app/                   # Головна директорія застосунку
    ├── api/
    │   ├── dependencies.py # Ін'єкції залежностей (get_db, get_current_user)
    │   └── routers/       # Ендпоінти FastAPI, згруповані за сутностями
    │       ├── auth.py    # Маршрути реєстрації, логіну, оновлення токенів, Google OAuth
    │       ├── cart.py    # Маршрути для перегляду та додавання товарів до кошика
    │       ├── clothing.py # Маршрути каталогу одягу (список, пошук, фільтрація, деталі)
    │       ├── favorite.py # Маршрути списку обраного (додавання, перегляд)
    │       ├── order.py   # Маршрути створення замовлень та перегляду історії
    │       └── user.py    # Маршрути управління профілем користувача та зміни пароля
    ├── core/
    │   ├── config.py      # Завантаження та збереження глобальних налаштувань (з .env)
    │   └── security.py    # Хешування паролів, перевірка та генерація JWT токенів
    ├── crud/              # Ізольовані SQL-запити до бази даних (Create, Read, Update, Delete)
    │   ├── crud_cart.py   # Операції з кошиком (додавання, оновлення кількості)
    │   ├── crud_clothing.py # Пошук, фільтрація та вибірка одягу
    │   ├── crud_favorite.py # Додавання/видалення товарів з обраного
    │   ├── crud_order.py  # Створення нових замовлень та вибірка історії
    │   └── crud_user.py   # Створення користувачів, пошук за email, оновлення даних
    ├── db/
    │   └── database.py    # Ініціалізація асинхронного рушія SQLAlchemy (Engine) та сесій (SessionMaker)
    ├── models/            # SQLAlchemy ORM моделі (структура таблиць у базі даних)
    │   ├── __init__.py    # Ініціалізація пакета моделей
    │   ├── bin.py         # Модель кошика (зв'язок: користувач - одяг - кількість)
    │   ├── clothing.py    # Модель товару (одяг, ціна, характеристики)
    │   ├── favorite.py    # Модель обраного товару
    │   ├── order.py       # Модель замовлення (дата, статус, дані для доставки)
    │   ├── order_content.py # Модель вмісту замовлення (зв'язок: замовлення - конкретний одяг)
    │   └── user.py        # Модель користувача (email, пароль, особисті дані)
    ├── schemas/           # Pydantic моделі (валідація вхідних/вихідних JSON даних)
    │   ├── cart.py        # Схеми для кошика та обраного (FavoriteCreate, CartItemCreate тощо)
    │   ├── clothing.py    # Схеми для каталогу одягу (проста, детальна, додаткові кольори)
    │   ├── order.py       # Схеми для створення та відображення замовлень
    │   └── user.py        # Схеми для реєстрації, логіну, оновлення профілю та пароля
    └── services/          # Директорія для складної бізнес-логіки, яка не стосується безпосередньо БД (наприклад, інтеграція платіжних систем)